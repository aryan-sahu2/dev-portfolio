<script>
  import * as THREE from 'three';
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // ─── Three.js Particle System ───────────────────────────────────
  const canvas = document.getElementById('canvas-3d');
  if (canvas) {
    const scene = new THREE.Scene();
    scene.background = null;

    const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 30;

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
    });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

    // — Particles
    const particleCount = 2000;
    const geometry = new THREE.BufferGeometry();
    const positions = new Float32Array(particleCount * 3);

    for (let i = 0; i < particleCount * 3; i++) {
      positions[i] = (Math.random() - 0.5) * 80;
    }

    geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));

    const material = new THREE.PointsMaterial({
      color: 0xffffff,
      size: 0.08,
      transparent: true,
      opacity: 0.6,
      blending: THREE.AdditiveBlending,
    });

    const particles = new THREE.Points(geometry, material);
    scene.add(particles);

    // — Connections (neural net style)
    const connectionPositions = [];
    const connectionThreshold = 3.5;

    function updateConnections() {
      const pos = geometry.attributes.position.array;
      connectionPositions.length = 0;

      for (let i = 0; i < particleCount; i++) {
        for (let j = i + 1; j < Math.min(i + 8, particleCount); j++) {
          const i3 = i * 3;
          const j3 = j * 3;
          const dx = pos[i3] - pos[j3];
          const dy = pos[i3 + 1] - pos[j3 + 1];
          const dz = pos[i3 + 2] - pos[j3 + 2];
          const dist = Math.sqrt(dx * dx + dy * dy + dz * dz);

          if (dist < connectionThreshold && Math.random() > 0.7) {
            connectionPositions.push(pos[i3], pos[i3 + 1], pos[i3 + 2]);
            connectionPositions.push(pos[j3], pos[j3 + 1], pos[j3 + 2]);
          }
        }
      }
    }

    updateConnections();

    const connGeometry = new THREE.BufferGeometry();
    const connMaterial = new THREE.LineBasicMaterial({
      color: 0xffffff,
      transparent: true,
      opacity: 0.05,
    });
    const connectionLines = new THREE.LineSegments(connGeometry, connMaterial);
    scene.add(connectionLines);
    connectionLines.visible = false;

    // — Mouse tracking
    let mouseX = 0;
    let mouseY = 0;
    let targetMouseX = 0;
    let targetMouseY = 0;

    document.addEventListener('mousemove', (e) => {
      targetMouseX = (e.clientX / window.innerWidth) * 2 - 1;
      targetMouseY = -(e.clientY / window.innerHeight) * 2 + 1;
    });

    // — Scroll tracking for parallax
    let scrollY = 0;
    document.addEventListener('scroll', () => {
      scrollY = window.scrollY;
    });

    // — Resize handler
    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });

    // — Animation loop
    let time = 0;

    function animate() {
      requestAnimationFrame(animate);
      time += 0.0005;

      // Smooth mouse follow
      mouseX += (targetMouseX - mouseX) * 0.02;
      mouseY += (targetMouseY - mouseY) * 0.02;

      // Rotate particles slowly
      particles.rotation.x += 0.0001;
      particles.rotation.y += 0.0002;

      // Parallax on scroll
      const parallaxOffset = scrollY * 0.002;
      particles.position.y = -parallaxOffset;

      // Subtle mouse-driven displacement on camera
      camera.position.x += (mouseX * 2 - camera.position.x) * 0.01;
      camera.position.y += (-mouseY * 2 - camera.position.y) * 0.01;
      camera.lookAt(scene.position);

      renderer.render(scene, camera);
    }

    animate();
  }

  // ─── GSAP Scroll Animations ─────────────────────────────────────
  // Hero
  gsap.from('[data-gsap-hero]', {
    y: 60,
    opacity: 0,
    duration: 1,
    stagger: 0.2,
    ease: 'power3.out',
  });

  // Sections - fade in on scroll
  gsap.utils.toArray('[data-gsap-section]').forEach((section) => {
    gsap.from(section.querySelector('[data-gsap-fade]'), {
      y: 40,
      opacity: 0,
      duration: 0.8,
      stagger: 0.15,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: section,
        start: 'top 80%',
        toggleActions: 'play none none none',
      },
    });
  });

  // Terminal section
  const terminalSection = document.getElementById('logs');
  if (terminalSection) {
    gsap.from(terminalSection.querySelector('.caption-mono'), {
      y: 30,
      opacity: 0,
      duration: 0.6,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: terminalSection,
        start: 'top 80%',
      },
    });
    gsap.from(terminalSection.querySelector('.display-md'), {
      y: 30,
      opacity: 0,
      duration: 0.6,
      delay: 0.1,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: terminalSection,
        start: 'top 80%',
      },
    });
    gsap.from(terminalSection.querySelector('.body-lg'), {
      y: 30,
      opacity: 0,
      duration: 0.6,
      delay: 0.2,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: terminalSection,
        start: 'top 80%',
      },
    });
    gsap.from(terminalSection.querySelector('[data-gsap-fade]'), {
      y: 40,
      opacity: 0,
      duration: 0.8,
      delay: 0.3,
      ease: 'power2.out',
      scrollTrigger: {
        trigger: terminalSection,
        start: 'top 80%',
      },
    });
  }
</script>

<style is:global>
  #canvas-3d {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
  }
</style>

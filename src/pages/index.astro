---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import LoreSection from '../components/LoreSection.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectTile from '../components/ProjectTile.astro';
import DiagnosticsSection from '../components/DiagnosticsSection.astro';
import PhilosophySection from '../components/PhilosophySection.astro';
import ContactSection from '../components/ContactSection.astro';
import { experience, projects } from '../data';
---

<Layout>
  <Header />
  <Hero />
  <LoreSection />

  <SectionHeader
    id="experience"
    eyebrow="EXPERIENCE"
    title="Where I've shipped"
    text="From enterprise banking systems to being a startup's first engineer."
  />
  {experience.map((entry) => <ProjectTile {...entry} />)}

  <SectionHeader
    id="projects"
    eyebrow="SIDE PROJECTS"
    title="Built outside the day job"
    text="Smaller things I build to solve a real problem, or to learn something properly."
  />
  {projects.map((entry) => <ProjectTile {...entry} />)}

  <DiagnosticsSection />
  <PhilosophySection />
  <ContactSection />
  <Footer />
</Layout>

<script>
  import '../scripts/particles';
  import '../scripts/scroll-animations';
</script>

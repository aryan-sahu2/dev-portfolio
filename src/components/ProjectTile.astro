---
import type { Entry } from '../data';

type Props = Entry;

const {
  title,
  subtitle,
  badge,
  period,
  current = false,
  summary,
  bullets,
  outcome,
  metrics = [],
  link,
} = Astro.props;
---

<section class="w-full bg-transparent border-b border-hairline/30 py-16 md:py-24 px-4 md:px-8 flex flex-col items-center" data-gsap-section>
  <div
    class:list={['max-w-[1024px] w-full', current && 'border-l-2 border-accent-sunset pl-5 md:pl-8']}
    data-gsap-fade
  >
    <div class="flex flex-wrap items-center gap-3 mb-3">
      {badge && <span class="caption-mono text-body-mid">{badge}</span>}
      <span
        class:list={[
          'caption-mono-sm rounded-pill border px-2.5 py-0.5',
          current ? 'border-accent-sunset/60 text-accent-sunset' : 'border-hairline text-body-mid',
        ]}
      >{period}</span>
    </div>

    <h2 class="display-md text-ink mb-4">{title}</h2>
    <p class="body-lg text-body mb-6">{subtitle}</p>

    <div class="text-body space-y-4 text-[15px] leading-relaxed">
      <p>{summary}</p>
      {bullets.length > 0 && (
        <ul class="space-y-2 text-body-mid">
          {bullets.map((b) => (
            <li class="flex items-start gap-2">
              <span class="text-zinc-600 flex-shrink-0" aria-hidden="true">▹</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      )}
      {outcome && <p class="text-ink text-lg leading-snug pt-2">{outcome}</p>}
    </div>

    {link && (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        data-magnet
        class="inline-flex items-center justify-center mt-8 text-sm font-normal rounded-pill px-5 py-2.5 transition-all duration-150 border border-white/20 text-white hover:bg-white/90 hover:text-black active:scale-95"
      >
        {link.text} ↗
      </a>
    )}

    {metrics.length > 0 && (
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 w-full border-t border-hairline pt-8 mt-8">
        {metrics.map((metric) => (
          <div class="flex flex-col">
            <span class="display-xs text-ink font-normal">{metric.value}</span>
            <span class="caption-mono-sm text-body-mid mt-1">{metric.label}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

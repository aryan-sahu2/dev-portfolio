---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  text: string;
}

const { id, eyebrow, title, text } = Astro.props;
---

<section {id}
  class="w-full bg-transparent border-b border-hairline/30 py-16 md:py-24 px-4 md:px-8 flex flex-col items-center scroll-mt-10"
>
  <div class="max-w-[1024px] w-full">
    <span class="caption-mono text-body-mid mb-3 block">{eyebrow}</span>
    <h2 class="display-md text-ink mb-4">{title}</h2>
    <p class="body-lg text-body max-w-[640px]">{text}</p>
  </div>
</section>
